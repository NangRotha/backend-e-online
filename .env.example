# =====================================================
# PostgreSQL (Render) — Database Config
# ចម្លងឯកសារនេះទៅជា .env ហើយបំពេញតម្លៃរបស់អ្នក
# =====================================================

# External Database URL (សម្រាប់ Local / Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.singapore-postgres.render.com/DBNAME

# Internal Database URL (សម្រាប់ Render តែប៉ុណ្ណោះ)
DATABASE_URL_INTERNAL=postgresql://USER:PASSWORD@HOST/DBNAME

# =====================================================
# CORS — បញ្ជី Origin ដែលអនុញ្ញាតឱ្យភ្ជាប់មក API (ញែកដោយសញ្ញាក្បៀស)
# ឧទាហរណ៍៖ https://your-shop.vercel.app,https://your-admin.vercel.app
# (localhost ត្រូវបានអនុញ្ញាតដោយស្វ័យប្រវត្តិសម្រាប់ Dev)
# =====================================================
CORS_ORIGINS=

# =====================================================
# Uploads — ថតរក្សារូបភាព Upload (បើទុកទទេ = backend/uploads/)
# នៅលើ Render បើប្រើ Persistent Disk ដាក់ដូចជា៖ /var/data/uploads
# =====================================================
UPLOAD_DIR=

# =====================================================
# Auth (JWT)
# =====================================================
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =====================================================
# SMTP — សម្រាប់ផ្ញើ OTP Email ទៅអ្នកប្រើប្រាស់លើសកលលោក
# ប្រើ Gmail App Password (https://myaccount.google.com/apppasswords)
# ឬអាចប្តូរទៅ provider ផ្សេងទៀត (Yahoo, Outlook, Zoho, Brevo, SendGrid, Mailgun...)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=
SMTP_FROM_NAME=E-Commerce Store
SMTP_USE_SSL=False
OTP_EXPIRE_MINUTES=10

# =====================================================
# Telegram Login Widget — សម្រាប់ Register/Login ជាមួយ Telegram
# បង្កើត Bot តាម @BotFather -> Token + Username
# បន្ទាប់មកប្រើ /setdomain ដាក់ domain ដោយគ្មាន https:// (ឧ. localhost:5173)
# =====================================================
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=YourShopBot

# =====================================================
# DeepSeek AI — សម្រាប់ AI Chatbot លើ Storefront
# យក API Key ពី https://platform.deepseek.com
# =====================================================
DEEPSEEK_API_KEY=your-deepseek-api-key

# =====================================================
# Cloudinary — រក្សាទុករូបភាព/វីដេអូ Upload ឱ្យមានស្ថេរភាព
# យកពី Cloudinary Dashboard -> Settings -> API Keys
# =====================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =====================================================
# UploadThing — ផ្ទុករូបភាព/វីដេអូ Upload លើ CDN អចិន្ត្រៃយ៍
# (ពេញចិត្តបំផុត — យក Token ពី https://uploadthing.com/dashboard -> API Keys)
# =====================================================
UPLOADTHING_TOKEN=your-uploadthing-token

# =====================================================
# ABA Pay / KHQRcc — សម្រាប់ឲ្យអតិថិជនបង់ប្រាក់តាម QR (Scan & Pay)
# យកពី https://khqr.cc Dashboard -> ABA Pay Gateway -> API Keys
# =====================================================
KHQRCC_PROFILE_ID=your-profile-id
KHQRCC_SECRET_KEY=your-secret-key
# URL របស់ Storefront (success_url ពេលអតិថិជនបង់ប្រាក់ចប់)
FRONTEND_URL=https://your-shop.vercel.app
